rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data.role == 'admin';
    }

    match /user_voyages/{email} {
      allow read, write: if request.auth != null && (request.auth.token.email.lower() == email.lower() || isAdmin());
    }

    match /users/{email} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.token.email.lower() == email.lower() || isAdmin());
    }

    match /sessions/{sessionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (resource == null || resource.data.email == request.auth.token.email.lower() || isAdmin());
    }
  }
}
